# MongoDB Connection
MONGODB_URI=mongodb+srv://channel_partner_database:Newpass123@channelpartner-prod.pmy5cc.mongodb.net/channelpartner?retryWrites=true&w=majority

# Server Port
PORT=5000

# JWT Secret (use a strong random string in production)
JWT_SECRET=your-secret-key-change-in-production

# Fast2SMS API Key (for OTP)
FAST2SMS_API_KEY=your-fast2sms-api-key

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Main Backend URLs
# App backend (where ads are displayed in the main app)
APP_BACKEND_URL=https://api.instantllycards.com

# Channel Partner backend (this service)
CHANNEL_BACKEND_URL=https://api.channel-partner.instantllycards.com

# Backwards compatible alias (existing code may still read MAIN_BACKEND_URL)
MAIN_BACKEND_URL=${CHANNEL_BACKEND_URL}

# Node Environment
NODE_ENV=development