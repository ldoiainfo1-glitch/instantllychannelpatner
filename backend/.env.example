# Example Environment Variables for Channel Partner Backend
# Copy this file to .env and fill in your values

# MongoDB Connection String
# For production: mongodb+srv://channel_partner_database:Newpass123@channelpartner-prod.pmy5cc.mongodb.net/channelpartner
# For development: mongodb://localhost:27017/channelpartner-dev
MONGODB_URI=your_mongodb_connection_string_here

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret - MUST be changed in production to a strong random string
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
